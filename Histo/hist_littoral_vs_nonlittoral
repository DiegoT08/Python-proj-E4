import os
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# === Paramètres ===
DATA_PATH = "data/cleaned/pred-mai-mef-dhup_clean.csv"
OUT_DIR = "outputs"
os.makedirs(OUT_DIR, exist_ok=True)

# === Chargement des données ===
def load_data(path):
    if not os.path.exists(path):
        raise FileNotFoundError(f"{path} introuvable. Copiez le CSV dans le dossier data/")
    df = pd.read_csv(path, sep=';', encoding='utf-8', low_memory=False)
    return df

df = load_data(DATA_PATH)

# === Nettoyage de la colonne des loyers ===
df = df[df["loypredm2"].notna()]
df = df[df["loypredm2"] > 0]
df = df[df["loypredm2"] < 60]

# === Liste locale des départements littoraux ===
DEPARTEMENTS_LITTORAUX = [
    "06","13","14","17","22","29","30","33","34","35","40",
    "44","50","56","59","62","64","66","76","83","85"
]

# === Séparation des groupes ===
df_littoral = df[df["DEP"].astype(str).isin(DEPARTEMENTS_LITTORAUX)]
df_non_littoral = df[~df["DEP"].astype(str).isin(DEPARTEMENTS_LITTORAUX)]

# === Moyennes ===
mean_littoral = df_littoral["loypredm2"].mean()
mean_non_littoral = df_non_littoral["loypredm2"].mean()

# === STYLE GRAPHIQUE CLAIR ===
plt.style.use("default")
sns.set_theme(style="whitegrid")
plt.figure(figsize=(10, 6))

# Histogrammes superposés
sns.histplot(df_littoral["loypredm2"], bins=35, color="#3182bd", label="Départements littoraux", alpha=0.5, kde=True)
sns.histplot(df_non_littoral["loypredm2"], bins=35, color="#e6550d", label="Autres départements", alpha=0.4, kde=True)

# Lignes de moyenne
plt.axvline(mean_littoral, color="#3182bd", linestyle="--", linewidth=2)
plt.axvline(mean_non_littoral, color="#e6550d", linestyle="--", linewidth=2)

# Annotations
plt.text(mean_littoral+0.2, plt.ylim()[1]*0.8, f"μ Littoral = {mean_littoral:.2f} €", color="#3182bd", fontsize=10)
plt.text(mean_non_littoral+0.2, plt.ylim()[1]*0.7, f"μ Autres = {mean_non_littoral:.2f} €", color="#e6550d", fontsize=10)

# Titre et axes
plt.title("Distribution des loyers moyens au m²\nLittoral vs Non-Littoral (France 2023)", fontsize=14, fontweight="bold")
plt.xlabel("Loyer moyen au m² (€)", fontsize=12)
plt.ylabel("Nombre de communes", fontsize=12)
plt.legend(frameon=True)
plt.tight_layout()

# === Sauvegarde ===
output_path = os.path.join(OUT_DIR, "hist_littoral_vs_nonlittoral.png")
plt.savefig(output_path, dpi=300, bbox_inches="tight")
plt.show()

print(f"✅ Histogramme littoral/non-littoral enregistré dans : {output_path}")
